<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Loggers>
        <!-- Hide everything by default -->
        <Root level="OFF"/>

        <!-- Keep Minecraft & Fabric logs -->
        <Logger name="Minecraft" level="warn" />
        <Logger name="FabricLoader" level="warn"/>

        <!-- Keep Frejaware logs -->
        <Logger name="frejaware" level="debug" />
    </Loggers>
</Configuration>